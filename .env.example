# Supabase browser settings. The publishable key is safe for frontend use when RLS is configured.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only secrets belong in Supabase Edge Function secrets, never in VITE_* variables.
# SUPABASE_SERVICE_ROLE_KEY=server_only_secret
